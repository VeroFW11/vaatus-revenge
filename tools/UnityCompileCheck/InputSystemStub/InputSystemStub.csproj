<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compile-only stand-in for the subset of com.unity.inputsystem the game uses. Never used by Unity. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Unity.InputSystem</AssemblyName>
    <NoWarn>$(NoWarn);CS0067;CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" />
  </ItemGroup>
</Project>
